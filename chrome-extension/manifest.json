{
  "manifest_version": 3,
  "name": "Karthera PDF Validator",
  "version": "1.0.0",
  "description": "Validates live Karthera application data against FDA review PDFs using FastAPI backend.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "*://*/*"
  ]
}
