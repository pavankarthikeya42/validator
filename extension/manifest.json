{
  "manifest_version": 2,
  "name": "Document Validator",
  "description": "Floating pen button to validate UI documents against embedded PDFs",
  "version": "1.0.0",

  "permissions": [
    "storage",
    "tabs",
    "http://localhost:8765/*",
    "http://*/*",
    "https://*/*",
    "file://*/*"
  ],

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "browser_action": {
    "default_icon": {
      "48": "icons/icon.svg"
    }
  },

  "icons": {
    "16":  "icons/icon.svg",
    "48":  "icons/icon.svg",
    "128": "icons/icon.svg"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "document-validator@local",
      "strict_min_version": "57.0"
    }
  }
}
