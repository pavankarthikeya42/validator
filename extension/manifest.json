{
  "manifest_version": 3,
  "name": "Document Validator",
  "description": "Floating pen button to validate UI documents against embedded PDFs",
  "version": "1.0.0",

  "permissions": [
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "http://localhost:8765/*",
    "http://*/*",
    "https://*/*",
    "file://*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "action": {
    "default_icon": {
      "48": "icons/icon.svg"
    }
  },

  "icons": {
    "16":  "icons/icon.svg",
    "48":  "icons/icon.svg",
    "128": "icons/icon.svg"
  }
}
